{
  "bsonType": "object",
  "description": "黑名单（单向：我拉黑他 ≠ 他拉黑我）。(owner_id,target_id) 一组唯一，两个方向各存一行。",
  "required": [
    "owner_id",
    "target_id"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "owner_id": {
      "bsonType": "string",
      "description": "拉黑发起人 = 我",
      "foreignKey": "uni-id-users._id"
    },
    "target_id": {
      "bsonType": "string",
      "description": "被拉黑的人",
      "foreignKey": "uni-id-users._id"
    },
    "created_at": {
      "bsonType": "long",
      "description": "拉黑时间，Date.now() 毫秒时间戳"
    }
  }
}
